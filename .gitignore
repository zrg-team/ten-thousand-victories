# Dependencies and generated build output (including nested app packages).
node_modules/
dist/
# The shell build — `yarn build:shell`. Same status as dist/: a build artifact, and the one every
# cabinet in apps/ serves.
dist-shell/
output/
.vite/
*.log
*.tsbuildinfo
.eslintcache
.stylelintcache
.cache/

# Browser/test output. Reviewed evidence belongs in docs/, not these run directories.
/coverage/
/playwright-report/
/test-results/
/blob-report/

# Local environment overrides; keep documented examples available to commit.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# OS/editor state. Shared .vscode settings and agent instructions remain source.
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/*.local.json
.claude/settings.local.json

# Yarn writes this install cache on every install; it is not source.
.yarn/install-state.gz
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# Screenshot output from the test_scripts/shot/ drivers. Written relative to the project root,
# so it stays at the top of the tree rather than under shot/.
test_scripts/shots/

# Screenshot dropped by check-console.mjs
tmp-verify.png

# Throwaway diagnostic harnesses — scripts written to answer one question about a running build
# and then thrown away. They are working notes, not source, and they accumulate every session, so
# the whole folder is ignored rather than a name prefix. The keepers live in the sibling families:
# verify/, shot/, perf/, playtest/, diag/, gate/.
test_scripts/scratch/
# The old flat location, kept so a stale `_*.mjs` left in a working tree is still ignored.
test_scripts/_*.mjs

# Ignore new performance runs, but preserve the existing reviewed reference data.
# Match the contents rather than the directory so these exceptions remain reachable.
/test_scripts/perf-results/*
!/test_scripts/perf-results/README.md
!/test_scripts/perf-results/base-head.json
!/test_scripts/perf-results/baseline.json
!/test_scripts/perf-results/baseline2.json
!/test_scripts/perf-results/cull-final.json
!/test_scripts/perf-results/final.json
!/test_scripts/perf-results/map-after.png
!/test_scripts/perf-results/map-control.png
!/test_scripts/perf-results/phase1.json
!/test_scripts/perf-results/phase2.json
!/test_scripts/perf-results/phase3.json
!/test_scripts/perf-results/phase4.json

# Native build staging, moved out of the deep apps/mobile/android path so Windows MAX_PATH is
# not hit. Build output, same status as dist/. See apps/mobile/plugins/withShortNativeBuildPath.js
.ncxx/

# Signing material. Never in the repository, on any branch, ever: an upload keystore or an App
# Store Connect key in a commit is a rotation at best and a hijacked listing at worst. The keys
# themselves live outside the tree (~/.android-keys, ~/.appstore-keys) — these patterns exist so
# that a copy landing here by accident is invisible to `git add .` rather than merely discouraged.
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.mobileprovision

# Local iOS credentials: absolute paths to a .p12 and .mobileprovision, plus the p12 password in
# clear. Machine-specific and secret on both counts — it is written by hand on each machine that
# builds, and never travels.
credentials.json

# The gameplay trailer's output — two thousand captured frames, two thousand composed ones and the
# cut itself. Same status as the promo film's: large, and rebuilt by `yarn trailer`.
scripts/trailer/out/

# Python bytecode from the art tooling in scripts/conquest-art.
__pycache__/
*.pyc

# Icon-design scratch under docs/design that is either regenerated on demand or a byte-for-byte
# copy of something already committed elsewhere. `scripts/icons/package-river-icons.mjs` rebuilds
# the first two from apps/mobile/assets; the rest duplicated apps/mobile/branding/ and public/,
# which are the single sources. Keeping them cost 36 MB for zero information. The parts a gate
# actually reads — icon-pack/android and icon-pack/ios — are committed.
docs/design/*/native-export-check/
docs/design/*/icon-pack/web/
docs/design/*/icon-pack/sources/
docs/design/*/*.zip
docs/design/*/preview.html
