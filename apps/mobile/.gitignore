node_modules/
.expo/
dist/
/android/
/ios/

# Local xcodebuild archives and exported IPAs from scripts/ios.mjs.
/build/

# Written by `yarn sync` out of the repository root's dist-shell/. A build artifact of a build
# artifact — never source, and 4.9 MB of it.
assets/web.zip
assets/web-version.json

# Exported by `yarn sync`: approved river sources live in branding/.
assets/icon.png
assets/adaptive-icon.png
assets/monochrome-icon.png
assets/icon-tinted.png
assets/splash.png

# The submission kit's binaries. Its text and images are generated by
# `yarn store:kit` and are small; the artefacts you download into builds/ are not.
store/*/builds/*
!store/*/builds/README.md

# Signing material. Never in the repository, on any branch, ever: an upload keystore or an App
# Store Connect key in a commit is a rotation at best and a hijacked listing at worst. The keys
# themselves live outside the tree (~/.android-keys, ~/.appstore-keys) — these patterns exist so
# that a copy landing here by accident is invisible to `git add .` rather than merely discouraged.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Local iOS credentials: absolute paths to a .p12 and .mobileprovision, plus the p12 password in
# clear. Machine-specific and secret on both counts — it is written by hand on each machine that
# builds, and never travels.
credentials.json
