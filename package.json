    "verify:special-heroes": "node test_scripts/verify/verify-special-heroes.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "sw": "node scripts/build-sw.mjs",
    "promo": "node scripts/promo/build-promo.mjs",
    "promo:wide": "node scripts/promo/build-promo.mjs --w 1920 --h 1080",
