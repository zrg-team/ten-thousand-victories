{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": { "EAS_BUILD_NO_EXPO_GO_WARNING": "true" },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "preview"
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "channel": "simulator"
    },
    "production": {
      "env": { "EAS_BUILD_NO_EXPO_GO_WARNING": "true" },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "credentialsSource": "local"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "appleTeamId": "YSCGCQK287",
        "ascAppId": "6805950974"
      }
    }
  }
}
