{
  "name": "van-thang-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "The Steam / desktop cabinet for Vạn Thắng — Electron around the shell build.",
  "author": "Zrg Team",
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync-web.mjs",
    "start": "electron .",
    "dist": "electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "dist:installers": "electron-builder --config.electronDist=node_modules/electron/dist",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "build": {
    "appId": "team.zrg.vanthang",
    "productName": "Van Thang",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": ["dir", "nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vạn Thắng",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Vạn Thắng ${version}",
      "artifactName": "van-thang-${version}-setup-${arch}.${ext}"
    },
    "mac": {
      "target": ["dir", "dmg"],
      "category": "public.app-category.strategy-games",
      "icon": "build/icon.png",
      "artifactName": "van-thang-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["dir", "AppImage"],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "van-thang-${version}-${arch}.${ext}"
    }
  }
}
