{
  "expo": {
    "name": "Vạn Thắng",
    "slug": "ten-thousand-victories",
    "orientation": "portrait",
    "scheme": "vanthang",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#e9dfc2",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "zrg.team.vanthang",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "419"
    },
    "android": {
      "package": "zrg.team.vanthang",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#f6edd7"
      },
      "versionCode": 419
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e9dfc2",
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#e9dfc2"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withLoopbackCleartext",
      "./plugins/withShortNativeBuildPath",
      "./plugins/withUploadSigning",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "dc75f332-8091-4337-a308-7f82a51aee13"
      }
    },
    "owner": "zerglingno2s-team",
    "updates": {
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/dc75f332-8091-4337-a308-7f82a51aee13"
    }
  }
}
